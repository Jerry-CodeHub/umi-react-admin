{
  "*.{md,json}": ["prettier --cache --write"],
  "*.{js,jsx,mjs,cjs}": ["eslint --fix --max-warnings=0", "prettier --cache --write"],
  "*.{css,less}": ["max lint --fix --stylelint-only", "prettier --cache --write"],
  "*.ts?(x)": ["eslint --fix --max-warnings=0", "prettier --cache --parser=typescript --write"]
}
