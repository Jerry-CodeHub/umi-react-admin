{
  "private": true,
  "description": "Open-source admin template on Umi Max 4, React 19 and Ant Design 6: Cesium/OpenLayers maps, dark mode, i18n and a coherent live-data CRUD demo",
  "keywords": [
    "react",
    "antd",
    "admin",
    "umi",
    "umijs",
    "typescript",
    "admin-dashboard",
    "backend-management",
    "template"
  ],
  "homepage": "https://jerry-codehub.github.io/umi-react-admin",
  "bugs": {
    "url": "https://github.com/Jerry-CodeHub/umi-react-admin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerry-CodeHub/umi-react-admin.git"
  },
  "license": "MIT",
  "author": "Jerry - li <lishuai4415@gmail.com>",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "audit:security": "node scripts/dependency-audit.mjs",
    "build": "max build",
    "build:demo": "cross-env UMI_APP_DEMO_MODE=true max build",
    "build:github:demo": "cross-env UMI_ENV=github UMI_APP_DEMO_MODE=true max build",
    "build:real": "cross-env UMI_APP_DEMO_MODE=false UMI_APP_API_BASE=/ max build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "e2e": "playwright test",
    "e2e:build": "pnpm build:github:demo && playwright test",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "pnpm lint:eslint && pnpm lint:style",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.css\" tailwind.css",
    "prepare": "husky",
    "preview": "pnpm build:demo && node scripts/serve-dist.mjs dist / 8001",
    "setup": "max setup",
    "size": "pnpm build:demo && node scripts/check-bundle-size.mjs",
    "start": "max dev",
    "start:demo": "cross-env UMI_APP_DEMO_MODE=true max dev",
    "start:github:demo": "cross-env UMI_ENV=github UMI_APP_DEMO_MODE=true max dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^3.1.14-7",
    "@dnd-kit/core": "^6.3.1",
    "@fullcalendar/react": "^7.1.0",
    "@pansy/amap-api-loader": "^0.4.10",
    "@tinymce/tinymce-react": "^6.3.0",
    "@umijs/max": "^4.7.22",
    "antd": "^6.6.5",
    "cesium": "^1.146.0",
    "cesium-navigation-es6": "^3.0.9",
    "classnames": "^2.5.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "mgrs": "^2.2.0",
    "milsymbol": "^3.0.4",
    "ol": "^10.11.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-pdf": "^11.0.0",
    "signature_pad": "^5.1.4",
    "temporal-polyfill": "^1.0.5",
    "tinymce": "^8.9.2",
    "tinymce-i18n": "^26.9.28",
    "wavesurfer.js": "^8.0.1",
    "xgplayer": "^3.0.26",
    "xgplayer-music": "^3.0.26"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "all-contributors-cli": "^6.26.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "jszip": "3.10.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
