# Cesium Ion Token
# 从 https://ion.cesium.com/ 获取你的 token
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# 可选：真实后端 API 地址（配置后 request 走该 baseURL，替换演示 mock）
# UMI_APP_API_BASE=https://api.example.com


# 可选：高德 Web 端（JS API）Key 与安全密钥（https://console.amap.com 申请）。
# 不配置时高德演示页使用组件库自带的公共 key（配额不受控），正式部署建议配置自己的
# AMAP_KEY=
# AMAP_SECURITY_CODE=

# 可选：Clarity 统计项目 ID（模板默认不含任何统计脚本，配置后按你自己的项目上报）
# CLARITY_ID=
