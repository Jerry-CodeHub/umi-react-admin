{
  "private": true,
  "description": "基于 Umi Max + React 18 + Ant Design 5 的开箱即用后台管理模板（Cesium/OpenLayers 地图、暗色模式、双语、CRUD 演示）",
  "keywords": [
    "react",
    "antd",
    "admin",
    "umi",
    "umijs",
    "typescript",
    "admin-dashboard",
    "backend-management",
    "template"
  ],
  "homepage": "https://jerry-codehub.github.io/umi-react-admin",
  "bugs": {
    "url": "https://github.com/Jerry-CodeHub/umi-react-admin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerry-CodeHub/umi-react-admin.git"
  },
  "license": "MIT",
  "author": "Jerry - li <lishuai4415@gmail.com>",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "build:github": "cross-env UMI_ENV=github max build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "pnpm lint:eslint && pnpm lint:style",
    "lint:eslint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs,.cjs --max-warnings=0",
    "lint:style": "max lint --stylelint-only",
    "prepare": "husky",
    "preview": "pnpm build && pnpm max preview --port 8001",
    "setup": "max setup",
    "size": "pnpm build && node scripts/check-bundle-size.mjs",
    "start": "max dev",
    "start:github": "cross-env UMI_ENV=github max dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
