# 仓库不指定 registry（CI、Docker 与全球贡献者默认走 npm 官方源）。
# 国内开发者请在自己的 ~/.npmrc 配置镜像，例如：registry=https://registry.npmmirror.com/
# 注意镜像源不支持 audit 通道，安全审计需显式走官方源：
#   pnpm audit --registry=https://registry.npmjs.org/

# 将依赖提升至node_modules根目录。
shamefully-hoist=true

# 如果希望自动安装对等依赖项
auto-install-peers=true

# 如果您不希望pnpm在对等依赖问题上失败
strict-peer-dependencies=false

# 锁文件纪律：不在 .npmrc 全局关闭 frozen-lockfile。
# CI/GitHub Actions 已显式 --frozen-lockfile，Vercel 由 vercel.json 的 installCommand 锁定，
# pnpm 在 CI 环境也会自动启用 frozen 模式；本地开发保持默认以便更新锁文件。
