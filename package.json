{
  "private": true,
  "description": "基于 Umi Max + React 18 + Ant Design 5 的开箱即用后台管理模板（Cesium/OpenLayers 地图、暗色模式、双语、CRUD 演示）",
  "keywords": [
    "react",
    "antd",
    "admin",
    "umi",
    "umijs",
    "typescript",
    "admin-dashboard",
    "backend-management",
    "template"
  ],
  "homepage": "https://jerry-codehub.github.io/umi-react-admin",
  "bugs": {
    "url": "https://github.com/Jerry-CodeHub/umi-react-admin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jerry-CodeHub/umi-react-admin.git"
  },
  "license": "MIT",
  "author": "Jerry - li <lishuai4415@gmail.com>",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build",
    "build": "max build",
    "build:github": "cross-env UMI_ENV=github max build",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --cache --write .",
    "postinstall": "max setup",
    "lint": "pnpm lint:eslint && pnpm lint:style",
    "lint:eslint": "eslint . --max-warnings=0",
    "lint:style": "stylelint \"src/**/*.{css,less}\" tailwind.css",
    "prepare": "husky",
    "preview": "pnpm build && pnpm max preview --port 8001",
    "setup": "max setup",
    "size": "pnpm build && node scripts/check-bundle-size.mjs",
    "start": "max dev",
    "start:github": "cross-env UMI_ENV=github max dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/plots": "^2.6.8",
    "@ant-design/pro-components": "^2.8.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fullcalendar/react": "^7.1.0",
    "@pansy/react-amap": "^2.21.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "@turf/helpers": "^7.2.0",
    "@turf/union": "^7.2.0",
    "@umijs/max": "^4.7.19",
    "antd": "^5.29.3",
    "cesium": "^1.145.0",
    "cesium-navigation-es6": "^3.0.9",
    "classnames": "^2.5.1",
    "d3": "^7.9.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.15",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "ol": "^10.10.0",
    "pdfjs-dist": "5.4.296",
    "react-pdf": "^10.5.0",
    "signature_pad": "^5.1.4",
    "temporal-polyfill": "^1.0.5",
    "tinymce": "^8.9.2",
    "wavesurfer.js": "^7.12.12",
    "xgplayer": "^3.0.26",
    "xgplayer-music": "^3.0.26"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "all-contributors-cli": "^6.26.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "stylelint": "^17.15.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.27.1",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
